#!/usr/bin/env bash
set -e

REAL_HOME="$(getent passwd "$USER" 2>/dev/null | cut -d: -f6)"
[[ -z "$REAL_HOME" ]] && REAL_HOME="${HOME%%/.agy-profiles*}"
PROFILES_BASE="${REAL_HOME}/.agy-profiles"
RR_STATE_FILE="/tmp/agy_rr_state"

CALL_NAME="$(basename "$0")"

probe_single() {
  local prof="$1"
  local target_pool="$2"
  local model_flag="gemini-3.8-flash-low"
  [[ "$target_pool" == "claude" ]] && model_flag="claude-sonnet-5-5-low"

  echo -n "  [Probing $prof ($target_pool)]... " >&2
  local res
  res=$(cd /tmp && HOME="$PROFILES_BASE/$prof" timeout 20 agy -p "echo ping" --model "$model_flag" --effort low < /dev/null 2>&1 || true)
  if echo "$res" | grep -qiE "(RESOURCE_EXHAUSTED|429|quota)"; then
    local m
    m=$(echo "$res" | grep -oE "Resets in [^\.]+" || echo "Limit reached")
    echo "[$m]" >&2
  else
    echo "[Confirmed READY]" >&2
  fi
}

# Analyze quota status of both pools (Gemini and Claude) purely from logs (instant, 0 tokens)
analyze_pools() {
  local p="$1"
  local p_dir="$PROFILES_BASE/$p"
  
  python3 -c "
import glob, os, re, sys, time

def parse_duration(d_str):
    hours = re.search(r'(\d+)\s*h', d_str)
    mins = re.search(r'(\d+)\s*m', d_str)
    secs = re.search(r'(\d+)\s*s', d_str)
    total = 0
    if hours: total += int(hours.group(1)) * 3600
    if mins: total += int(mins.group(1)) * 60
    if secs: total += int(secs.group(1))
    return total

p_dir = sys.argv[1]
res = {'gemini': 'READY', 'claude': 'READY'}
log_dir = os.path.join(p_dir, '.gemini/antigravity-cli/log')
if not os.path.exists(log_dir):
    print(f'gemini=\"{res[\"gemini\"]}\";claude=\"{res[\"claude\"]}\"')
    sys.exit(0)

logs = sorted(glob.glob(os.path.join(log_dir, 'cli-*.log')), key=os.path.getmtime, reverse=True)
if not logs:
    print(f'gemini=\"{res[\"gemini\"]}\";claude=\"{res[\"claude\"]}\"')
    sys.exit(0)

now = time.time()
for log_file in logs[:10]:
    log_mtime = os.path.getmtime(log_file)
    if now - log_mtime > 86400:
        continue
    try:
        with open(log_file, 'r', errors='ignore') as f:
            lines = f.readlines()
    except Exception:
        continue

    curr_pool = 'gemini'
    for line in lines:
        line_lower = line.lower()
        if 'resolving model' in line_lower or 'propagating selected model' in line_lower:
            if 'claude' in line_lower or 'gpt' in line_lower:
                curr_pool = 'claude'
            elif 'gemini' in line_lower:
                curr_pool = 'gemini'

        if 'errorreport.go' in line and ('resource_exhausted' in line_lower or 'code 429' in line_lower or 'quota reached' in line_lower):
            m = re.search(r'Resets in ([^\.]+)', line)
            if m:
                duration = parse_duration(m.group(1))
                reset_at = log_mtime + duration
                if now < reset_at:
                    rem = int(reset_at - now)
                    h = rem // 3600
                    mi = (rem % 3600) // 60
                    res[curr_pool] = f'LIMIT REACHED ({h}h {mi}m remaining)'
                else:
                    res[curr_pool] = 'READY'
            elif 'capacity exhausted' in line_lower:
                res[curr_pool] = 'CAPACITY SPIKE (Transient)'

print(f'gemini=\"{res[\"gemini\"]}\";claude=\"{res[\"claude\"]}\"')
" "$p_dir"
}

# Resolve command
case "$CALL_NAME" in
  agy-oktaya)
    PROFILE="oktaya"
    ;;
  agy-pufaysokt)
    PROFILE="pufaysokt"
    ;;
  agy-rr)
    PROFILE="rr"
    ;;
  agy-auto)
    PROFILE="auto"
    ;;
  *)
    if [[ "$1" == "oktaya" || "$1" == "pufaysokt" || "$1" == "rr" || "$1" == "round-robin" || "$1" == "auto" ]]; then
      PROFILE="$1"
      shift
    elif [[ "$1" == "status" || "$1" == "list" ]]; then
      echo "=== Antigravity (agy) Dual-Pool Quota Status ==="
      for p in oktaya pufaysokt; do
        token_path="$PROFILES_BASE/$p/.gemini/antigravity-cli/antigravity-oauth-token"
        auth_status="Pending login"
        if [[ -f "$token_path" ]]; then
          auth_status="Authenticated"
        fi
        
        # Fast, passive log inspection
        eval "$(analyze_pools "$p")"

        echo "• $p [$auth_status]:"
        if [[ "$gemini" =~ ^LIMIT ]]; then
          echo "    - Gemini Pool : [$gemini]"
        else
          echo "    - Gemini Pool : [READY]"
        fi
        if [[ "$claude" =~ ^LIMIT ]]; then
          echo "    - Claude Pool : [$claude]"
        else
          echo "    - Claude Pool : [READY]"
        fi
      done
      exit 0
    elif [[ "$1" == "probe" ]]; then
      target="${2:-all}"
      pool="${3:-all}"

      echo "=== Probing Server Status ==="
      for p in oktaya pufaysokt; do
        if [[ "$target" == "all" || "$target" == "$p" ]]; then
          echo "• Profile: $p"
          if [[ "$pool" == "all" || "$pool" == "gemini" ]]; then
            probe_single "$p" "gemini"
          fi
          if [[ "$pool" == "all" || "$pool" == "claude" ]]; then
            probe_single "$p" "claude"
          fi
        fi
      done
      exit 0
    elif [[ -z "$1" || "$1" =~ ^- ]]; then
      echo "======================================"
      echo "   Select Antigravity (agy) Profile   "
      echo "======================================"
      eval "$(analyze_pools "oktaya")"
      g_ok="$gemini"
      eval "$(analyze_pools "pufaysokt")"
      g_pu="$gemini"
      echo "1) oktaya    (Active: oktaya@gmail.com) [Gemini: $g_ok]"
      echo "2) pufaysokt (Secondary account)        [Gemini: $g_pu]"
      echo "3) auto      (Automatically pick ready profile)"
      echo "4) round-robin (Alternate profiles)"
      echo "q) Quit"
      echo ""
      read -rp "Enter choice [1-4, q]: " choice
      case "$choice" in
        1) PROFILE="oktaya" ;;
        2) PROFILE="pufaysokt" ;;
        3) PROFILE="auto" ;;
        4) PROFILE="rr" ;;
        q|Q) echo "Cancelled."; exit 0 ;;
        *) echo "Invalid choice."; exit 1 ;;
      esac
    else
      echo "Usage: $(basename "$0") [oktaya|pufaysokt|auto|rr|status|probe] [agy arguments...]"
      exit 1
    fi
    ;;
esac

# Handle auto selection
if [[ "$PROFILE" == "auto" ]]; then
  eval "$(analyze_pools "oktaya")"
  oktaya_gemini="$gemini"
  eval "$(analyze_pools "pufaysokt")"
  pufaysokt_gemini="$gemini"

  if [[ ! "$oktaya_gemini" =~ ^LIMIT ]]; then
    PROFILE="oktaya"
  elif [[ ! "$pufaysokt_gemini" =~ ^LIMIT ]]; then
    PROFILE="pufaysokt"
  else
    echo "Warning: Both profiles appear to have hit Gemini limits recently!" >&2
    echo "  oktaya   Gemini: $oktaya_gemini" >&2
    echo "  pufaysokt Gemini: $pufaysokt_gemini" >&2
    echo "Defaulting to oktaya..." >&2
    PROFILE="oktaya"
  fi
  echo "[agy-auto] Selected profile: $PROFILE" >&2
fi

# Handle round-robin resolution
if [[ "$PROFILE" == "rr" || "$PROFILE" == "round-robin" ]]; then
  IDX=0
  if [[ -f "$RR_STATE_FILE" ]]; then
    IDX=$(cat "$RR_STATE_FILE" 2>/dev/null || echo 0)
  fi
  if [[ "$IDX" -eq 0 ]]; then
    PROFILE="oktaya"
    echo 1 > "$RR_STATE_FILE"
  else
    PROFILE="pufaysokt"
    echo 0 > "$RR_STATE_FILE"
  fi
  echo "[agy-rr] Selected profile: $PROFILE" >&2
fi

PROFILE_DIR="$PROFILES_BASE/$PROFILE"
if [[ ! -d "$PROFILE_DIR" ]]; then
  echo "Error: Profile directory $PROFILE_DIR not found!" >&2
  exit 1
fi

export HOME="$PROFILE_DIR"
exec agy "$@"
