#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
AGY_BIN="${SCRIPT_DIR}/agy.bin"
[[ ! -f "$AGY_BIN" ]] && AGY_BIN="$(which agy.bin 2>/dev/null || echo "$HOME/.local/bin/agy.bin")"

REAL_HOME="$(getent passwd "$USER" 2>/dev/null | cut -d: -f6)"
[[ -z "$REAL_HOME" ]] && REAL_HOME="${HOME%%/.agy-profiles*}"
PROFILES_BASE="${REAL_HOME}/.agy-profiles"
SUPERVISOR="${SCRIPT_DIR}/agy-supervisor.py"
[[ ! -f "$SUPERVISOR" ]] && SUPERVISOR="${REAL_HOME}/.local/bin/agy-supervisor.py"

# 1. If HOME is already set to an isolated profile, bypass router
if [[ "$HOME" == */.agy-profiles/* ]]; then
  exec "$AGY_BIN" "$@"
fi

# 2. Extract flags and determine TARGET_POOL
TARGET_POOL="${AGY_TARGET_POOL:-}"
MODEL=""
CONV_ID=""
is_stream_json=false

prev=""
for arg in "$@"; do
  if [[ "$prev" == "--conversation" ]]; then
    CONV_ID="$arg"
  fi
  if [[ "$prev" == "--model" || "$prev" == "-m" ]]; then
    MODEL="$arg"
  fi
  if [[ "$arg" == "stream-json" ]]; then
    is_stream_json=true
  fi
  prev="$arg"
done

if [[ -z "$TARGET_POOL" ]]; then
  if [[ "$MODEL" =~ ^claude || "$MODEL" =~ ^gpt ]]; then
    TARGET_POOL="claude"
  else
    TARGET_POOL="gemini"
  fi
fi

# 3. Account selection
CHOSEN="${AGY_PROFILE:-}"
if [[ -z "$CHOSEN" ]]; then
  CHOSEN=$(python3 -c "
import glob, os, re, sys, time

def parse_duration(d_str):
    hours = re.search(r'(\d+)\s*h', d_str)
    mins = re.search(r'(\d+)\s*m', d_str)
    secs = re.search(r'(\d+)\s*s', d_str)
    total = 0
    if hours: total += int(hours.group(1)) * 3600
    if mins: total += int(mins.group(1)) * 60
    if secs: total += int(secs.group(1))
    return total

def get_pool_status(prof, target_pool):
    log_dir = os.path.join('${PROFILES_BASE}', prof, '.gemini/antigravity-cli/log')
    if not os.path.exists(log_dir):
        return 'READY'
    logs = sorted(glob.glob(os.path.join(log_dir, 'cli-*.log')), key=os.path.getmtime, reverse=True)
    if not logs:
        return 'READY'
    now = time.time()
    for log_file in logs[:5]:
        log_mtime = os.path.getmtime(log_file)
        if now - log_mtime > 86400:
            continue
        try:
            with open(log_file, 'r', errors='ignore') as f:
                lines = f.readlines()
        except Exception:
            continue
        curr_pool = 'gemini'
        for line in lines:
            line_l = line.lower()
            if 'resolving model' in line_l or 'propagating selected model' in line_l:
                if 'claude' in line_l or 'gpt' in line_l:
                    curr_pool = 'claude'
                elif 'gemini' in line_l:
                    curr_pool = 'gemini'
            if curr_pool == target_pool and 'errorreport.go' in line and ('resource_exhausted' in line_l or 'code 429' in line_l or 'quota reached' in line_l):
                m = re.search(r'Resets in ([^\.]+)', line)
                if m:
                    dur = parse_duration(m.group(1))
                    if now < (log_mtime + dur):
                        return 'LIMIT'
    return 'READY'

s_oktaya = get_pool_status('oktaya', '${TARGET_POOL}')
s_puf = get_pool_status('pufaysokt', '${TARGET_POOL}')

if s_oktaya == 'READY':
    print('oktaya')
elif s_puf == 'READY':
    print('pufaysokt')
else:
    print('oktaya')
" 2>/dev/null || echo "oktaya")
fi

# 4. If running as a persistent stream-json agent (Paseo), launch via the supervisor
if [[ "$is_stream_json" == true && -f "$SUPERVISOR" ]]; then
  exec python3 "$SUPERVISOR" "$CHOSEN" "$@"
fi

# 5. Otherwise exec directly
export HOME="$PROFILES_BASE/$CHOSEN"
exec "$AGY_BIN" "$@"
